<Window x:Class="Prog_poe_part2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prog_poe_part2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid><!-- start of parent grid-->
        <Grid x:Name="home_grid" Visibility="Visible"><!-- start of home grid-->
            
            <!--ASCII art display-->
            <TextBlock
                x:Name="ascii_art_display"
                FontFamily="Bahnschrift"
                FontSize="7"
                Foreground="Purple"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                TextWrapping="Wrap"
                Width="880"/>
            
            
            <!--welcome message-->
            <TextBlock
                Text="Welcome to the Cybersecurity Awareness bot, Click to continue"
                Height="20"
                Width="400"
                TextAlignment="Center"
                Margin="0,-100,0,0"
                FontSize="16"
                FontFamily="Arial Black"/>
            
            <!-- button to continue-->
            <Button
                x:Name="Proceed"
                Height="40"
                Width="300"
                Margin="0,20,0,0"
                Content="Proceed"
                FontSize="14"
                Click="proceed"/>


        </Grid><!-- end of the home grid-->
        
        <Grid  x:Name="username_grid" Visibility="Collapsed"><!--start of username grid-->
            <!--hint message-->
            <TextBlock
                Text="Enter your Name"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Margin="0,-120,0,0"
                FontFamily="Arial Black"/>
            
            <!-- enter username-->
            <TextBox
                x:Name="usernames_input"
                Height="40"
                Width="300"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,-30,0,0"
                FontSize="14"
                Padding="5"
                KeyDown="usernames_input_key_down"/>
            
            <!-- error message-->
            <TextBlock
                Text="Please enter your name to continue"
                HorizontalAlignment="Center"
                VerticalAlignment="top"
                Margin="0,30,0,0"
                Foreground="Red"
                FontFamily="Arial Black"
                x:Name="name_error_label"
                Visibility="Collapsed"/>
            
            <!-- button to submit name-->
            <Button
                Height="40"
                Width="300"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,260,0,0"
                Content="Submit Name"
                FontSize="14"
                Click="submit_name"/>

        </Grid><!-- end of username grid-->

        <Grid x:Name="chat_grid" Visibility="Collapsed">
            <!-- navigation bar for part 3 panels -->
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="0,5,10,0"
                Height="30">
                <Button Content=" Chat" Width="70" Margin="3,0"
                        Click="btn_nav_chat_Click"/>
                <Button Content="Tasks" Width="70" Margin="3,0"
                        Click="btn_nav_tasks_Click"/>
                <Button Content=" Quiz" Width="70" Margin="3,0"
                        Click="btn_nav_quiz_Click"/>
                <Button Content=" Log" Width="70" Margin="3,0"
                        Click="btn_nav_log_Click"/>
            </StackPanel>

        

        <Grid x:Name="chat_panel" Visibility="Visible">
            <!--start of chat grid-->
            <!-- list view to show messages-->
            <ListView
                x:Name="chats"
                Height="380"
                Margin="10,10,10,160"/>

            <!-- topic buttons-->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,400,0,0"
                Height="30">

                <Button Content="Password" Width="90" Margin="3,0"
                        Click="topic_button_click" Tag="password"/>
                <Button Content="Phishing" Width="90" Margin="3,0"
                        Click="topic_button_click" Tag="phishing"/>
                <Button Content="Browsing" Width="90" Margin="3,0"
                        Click="topic_button_click" Tag="browsing"/>
                <Button Content="Malware" Width="90" Margin="3,0"
                        Click="topic_button_click" Tag="malware"/>
                <Button Content="VPN" Width="60" Margin="3,0"
                        Click="topic_button_click" Tag="vpn"/>
                <Button Content="Privacy" Width="80" Margin="3,0"
                        Click="topic_button_click" Tag="privacy"/>
                <Button Content="2FA" Width="60" Margin="3,0"
                        Click="topic_button_click" Tag="2fa"/>

            </StackPanel>

            <!-- textbox to type questions-->
            <TextBox
                x:Name="question"
                Height="50"
                Width="500"
                Margin="10,440,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"/>

            <!-- button to send -->
            <Button
                Height="40"
                Width="200"
                Margin="0,440,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Content="Send"
                Click="send"/>
            </Grid><!--end of chat panel-->

            <!-- TASKS PANEL -->
            <Grid x:Name="tasks_panel" Visibility="Collapsed" Margin="10,40,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text=" Task Assistant"
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txt_task_title" Grid.Column="0" Height="35"
                             Margin="0,0,8,0" FontSize="13" Padding="5"/>
                    <TextBox x:Name="txt_task_desc" Grid.Column="1" Height="35"
                             Margin="0,0,8,0" FontSize="13" Padding="5"/>
                    <Button Grid.Column="2" Content="Add Task" Height="35"
                            Click="btn_add_task_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="tasks_stack"/>
                </ScrollViewer>
            </Grid>

            <!-- QUIZ PANEL -->
            <Grid x:Name="quiz_panel" Visibility="Collapsed" Margin="30,40,30,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="🧠 Cybersecurity Quiz"
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock x:Name="txt_quiz_progress" Grid.Row="1"
                           FontSize="13" Foreground="Gray" Margin="0,0,0,15"/>
                <StackPanel x:Name="quiz_stack" Grid.Row="2"/>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,0">
                    <Button x:Name="btn_quiz_start" Content="Start Quiz"
                            Width="120" Height="38" Margin="0,0,10,0"
                            Click="btn_quiz_start_Click"/>
                    <Button x:Name="btn_quiz_submit" Content="Submit Answer"
                            Width="130" Height="38" Visibility="Collapsed"
                            Click="btn_quiz_submit_Click"/>
                </StackPanel>
            </Grid>

            <!-- ACTIVITY LOG PANEL -->
            <Grid x:Name="log_panel" Visibility="Collapsed" Margin="10,40,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text=" Activity Log"
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="log_stack"/>
                </ScrollViewer>
                <Button Grid.Row="2" Content="Clear Log" Width="110" Height="35"
                        HorizontalAlignment="Left" Margin="0,10,0,0"
                        Click="btn_clear_log_Click"/>
            </Grid>



        </Grid><!--end of chat grid-->
        
    </Grid><!--End of parent grid-->
</Window>
