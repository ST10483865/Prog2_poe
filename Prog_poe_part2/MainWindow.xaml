<Window x:Class="Prog_poe_part2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prog_poe_part2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid><!-- start of parent grid-->
        <Grid x:Name="home_grid" Visibility="Visible"><!-- start of home grid-->
            
            <!--ASCII art display-->
            <TextBlock
                x:Name="ascii_art_display"
                FontFamily="Bahnschrift"
                FontSize="7"
                Foreground="Purple"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                TextWrapping="Wrap"
                Width="880"/>
            
            
            <!--welcome message-->
            <TextBlock
                Text="Welcome to the Cybersecurity Awareness bot, Click to continue"
                Height="20"
                Width="400"
                TextAlignment="Center"
                Margin="0,-100,0,0"
                FontSize="16"
                FontFamily="Arial Black"/>
            
            <!-- button to continue-->
            <Button
                x:Name="Proceed"
                Height="40"
                Width="300"
                Margin="0,20,0,0"
                Content="Proceed"
                FontSize="14"
                Click="proceed"/>


        </Grid><!-- end of the home grid-->
        
        <Grid  x:Name="username_grid" Visibility="Collapsed"><!--start of username grid-->
            <!--hint message-->
            <TextBlock
                Text="Enter your Name"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Margin="0,-120,0,0"
                FontFamily="Arial Black"/>
            
            <!-- enter username-->
            <TextBox
                x:Name="usernames_input"
                Height="40"
                Width="300"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,-30,0,0"
                FontSize="14"
                Padding="5"
                KeyDown="usernames_input_key_down"/>
            
            <!-- error message-->
            <TextBlock
                Text="Please enter your name to continue"
                HorizontalAlignment="Center"
                VerticalAlignment="top"
                Margin="0,30,0,0"
                Foreground="Red"
                FontFamily="Arial Black"
                x:Name="name_error_label"
                Visibility="Collapsed"/>
            
            <!-- button to submit name-->
            <Button
                Height="40"
                Width="300"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,260,0,0"
                Content="Submit Name"
                FontSize="14"
                Click="submit_name"/>

        </Grid><!-- end of username grid-->

        <Grid x:Name="chat_grid" Visibility="Collapsed"><!--start of chat grid-->
            <!-- list view to show messages-->
            <ListView
                x:Name="chats"
                Height="380"
                Margin="10,10,10,160"/>
            
            <!-- topic buttons-->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,400,0,0"
                Height="30">

                <Button Content="Password" Width="90" Margin="3,0"
                        Click="topic_button_click" Tag="password"/>
                <Button Content="Phishing" Width="90" Margin="3,0"
                        Click="topic_button_click" Tag="phishing"/>
                <Button Content="Browsing" Width="90" Margin="3,0"
                        Click="topic_button_click" Tag="browsing"/>
                <Button Content="Malware" Width="90" Margin="3,0"
                        Click="topic_button_click" Tag="malware"/>
                <Button Content="VPN" Width="60" Margin="3,0"
                        Click="topic_button_click" Tag="vpn"/>
                <Button Content="Privacy" Width="80" Margin="3,0"
                        Click="topic_button_click" Tag="privacy"/>
                <Button Content="2FA" Width="60" Margin="3,0"
                        Click="topic_button_click" Tag="2fa"/>

            </StackPanel>
            
            <!-- textbox to type questions-->
            <TextBox
                x:Name="question"
                Height="50"
                Width="500"
                Margin="10,440,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"/>
            
            <!-- button to send -->
            <Button
                Height="40"
                Width="200"
                Margin="0,440,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Content="Send"
                Click="send"/>



        </Grid>
        
    </Grid><!--End of parent grid-->
</Window>
